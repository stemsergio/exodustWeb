@page
@model OptionsModel
@{
    ViewData["Title"] = "User options";
}

<h1>User options</h1>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}

<p>Select your plan:</p>
<form method="post">
    <div class="form-check">
        <input class="form-check-input" type="radio" asp-for="IsPaid" value="false" id="plan-free" />
        <label class="form-check-label" for="plan-free">Free (includes Google Ads banner)</label>
    </div>
    <div class="form-check mb-3">
        <input class="form-check-input" type="radio" asp-for="IsPaid" value="true" id="plan-paid" />
        <label class="form-check-label" for="plan-paid">Paid (ads-free)</label>
    </div>
    <button type="submit" class="btn btn-primary">Save plan</button>
</form>
