@model GameViewModel
@{
    ViewData["Title"] = "Game";
}

<h1>Game progress</h1>
<p class="lead">Level: <strong id="level">@Model.Level</strong></p>
<p class="lead">XP: <strong id="xp">@Model.ExperiencePoints</strong></p>

<form method="post" asp-action="GainXp">
    <button type="submit" class="btn btn-success">Gain 10 XP</button>
</form>
<h2 class="h4 mt-4">Consola</h2>
@Html.AntiForgeryToken()
<div id="console" class="bg-dark text-light p-3 font-monospace"
     style="height: 300px; overflow-y: auto; white-space: pre;"></div>
<input id="keys" class="form-control font-monospace mt-2" autocomplete="off"
       placeholder="Escribe w a s d y presiona Enter" />
@if (Model.ShowAdsBanner)
{
    <div class="alert alert-warning mt-4" role="region" aria-label="Google ads banner placeholder">
        <strong>Free plan:</strong> Google Ads banner area.
        <div class="mt-2 border p-2 bg-light text-center">
            <!-- Google Ads placeholder -->
            <ins class="adsbygoogle"
                 style="display:block"
                 data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
                 data-ad-slot="1234567890"
                 data-ad-format="auto"
                 data-full-width-responsive="true"></ins>
        </div>
    </div>
}

@section Scripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder().withUrl("/hubs/notifications").build();
        connection.on("ProgressUpdated", (level, xp) => {
            document.getElementById("level").textContent = level;
            document.getElementById("xp").textContent = xp;
        });
        connection.start().catch(() => {});
    </script>
    <script>
        const consoleEl = document.getElementById("console");
        const keysEl = document.getElementById("keys");

        function log(line) {
            consoleEl.textContent += line + "\n";
            consoleEl.scrollTop = consoleEl.scrollHeight;
        }

        async function connectToGame() {
            const antiforgery = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const res = await fetch('@Url.Action("Token", "Game")', {
                method: "POST",
                headers: { "RequestVerificationToken": antiforgery }
            });
            if (!res.ok) { log("No se pudo obtener el token (" + res.status + ")"); return; }
            const { token } = await res.json();

            const ws = new WebSocket(@Json.Serialize(Model.GameServerUrl));
            ws.onopen = () => { ws.send(token); log("Conectado al servidor."); };
            ws.onmessage = (e) => log(e.data);
            ws.onclose = (e) => log("Desconectado (" + e.code + " " + e.reason + ")");

            keysEl.addEventListener("keydown", (e) => {
                if (e.key === "Enter" && ws.readyState === WebSocket.OPEN) {
                    ws.send(keysEl.value);
                    log("> " + keysEl.value);
                    keysEl.value = "";
                }
            });
        }

        connectToGame();
    </script>
}
